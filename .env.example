# --- Aplikacja ---
# Adres i port, na którym nasłuchuje Node.js.
# 127.0.0.1 = tylko lokalnie (za Apache lub nginx). 0.0.0.0 = dostępne w całej sieci LAN bez serwera WWW.
HOST=127.0.0.1
PORT=3080

# --- Baza MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rack_inventory
DB_USER=rack
DB_PASSWORD=zmien_mnie
# Opcjonalnie połączenie przez gniazdo unix zamiast TCP:
# DB_SOCKET=/run/mysqld/mysqld.sock

# --- Logowanie (opcjonalne, HTTP Basic) ---
# Zostaw puste, żeby wyłączyć. Zalecane, jeśli aplikacja jest dostępna poza localhost.
# Hasło ze znakami # $ ` lub spacją wpisz w apostrofach: AUTH_PASSWORD='ab#c d'
# Po 10 nieudanych próbach z jednego adresu logowanie jest blokowane na 15 minut.
AUTH_USER=
AUTH_PASSWORD=

# --- Historia zmian portów ---
# Ile dni trzymać historię. 0 = bez limitu.
HISTORY_DAYS=0
